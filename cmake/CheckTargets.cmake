hive_require_dependencies(hive_planter_execution hive_planters ${HIVE_SHARED_TARGETS})
hive_require_dependencies(hive_planter_module hive_planter_execution ${HIVE_SHARED_TARGETS})
hive_require_dependencies(hive_collection ${HIVE_SHARED_TARGETS})
