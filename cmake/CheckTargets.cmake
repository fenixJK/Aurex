include("${CMAKE_CURRENT_LIST_DIR}/DependencyBoundaries.cmake")
hive_require_input_target("${PROJECT_SOURCE_DIR}" hive_core)
set(HIVE_SHARED_TARGETS hive_coordination hive_script_files hive_movement hive_core hive_execution hive_ocr hive_game hive_module_api hive_workflows hive_automation hive_session)
if(TARGET hive_platform)
  list(APPEND HIVE_SHARED_TARGETS hive_platform)
endif()
if(TARGET hive_account_connection)
  list(APPEND HIVE_SHARED_TARGETS hive_account_connection)
endif()
if(TARGET hive_reporting)
  list(APPEND HIVE_SHARED_TARGETS hive_reporting)
  hive_require_dependencies(hive_status_ui hive_reporting)
  hive_require_dependencies(hive_remote_controls hive_reporting hive_extensions_ui)
endif()
foreach(target IN LISTS HIVE_SHARED_TARGETS)
  if(target STREQUAL "hive_core")
    hive_require_dependencies(${target})
  elseif(target STREQUAL "hive_movement")
    hive_require_dependencies(${target} hive_workflows hive_lua hive_script_files)
  elseif(target STREQUAL "hive_account_connection")
    hive_require_dependencies(${target} ${HIVE_SHARED_TARGETS} libminiupnpc-static hive_natpmp)
  else()
    hive_require_dependencies(${target} ${HIVE_SHARED_TARGETS})
  endif()
  get_target_property(source_dir ${target} SOURCE_DIR)
  get_target_property(sources ${target} SOURCES)
  foreach(source IN LISTS sources)
    cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${source_dir}" NORMALIZE OUTPUT_VARIABLE absolute)
    # Qt-generated data for the reporting library's bundled icons.
    if(target STREQUAL "hive_reporting" AND absolute STREQUAL "${PROJECT_BINARY_DIR}/src/reporting/qrc_report_icons.cpp")
      continue()
    endif()
    hive_require_shared_file("${PROJECT_SOURCE_DIR}" "${absolute}")
  endforeach()
endforeach()
hive_check_shared_sources("${PROJECT_SOURCE_DIR}")
hive_check_core_sources("${PROJECT_SOURCE_DIR}")
hive_require_dependencies(hive_routines hive_automation)
hive_require_dependencies(hive_scripts hive_automation hive_lua hive_routines)
hive_check_module_sources("${PROJECT_SOURCE_DIR}")
