set(BUILD_LIST "core,imgproc" CACHE STRING "OpenCV components" FORCE)
foreach(option BUILD_SHARED_LIBS BUILD_TESTS BUILD_PERF_TESTS BUILD_EXAMPLES
    BUILD_opencv_apps BUILD_JAVA BUILD_opencv_python2 BUILD_opencv_python3
    WITH_IPP WITH_OPENCL WITH_ITT WITH_TBB WITH_LAPACK
    WITH_TIFF WITH_PNG WITH_JPEG WITH_OPENJPEG WITH_OPENEXR WITH_WEBP WITH_AVIF
    WITH_JASPER WITH_KLEIDICV WITH_PROTOBUF BUILD_PROTOBUF WITH_FLATBUFFERS WITH_ADE WITH_EIGEN WITH_OPENGL)
  set(${option} OFF CACHE BOOL "Minimal release dependency" FORCE)
endforeach()
if(CMAKE_HOST_WIN32)
  set(BUILD_WITH_STATIC_CRT ON CACHE BOOL "Static Windows runtime" FORCE)
  set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>" CACHE STRING "Windows runtime" FORCE)
else()
  set(BUILD_WITH_STATIC_CRT OFF CACHE BOOL "Static Windows runtime" FORCE)
endif()
