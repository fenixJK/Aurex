set(BUILD_SHARED_LIBS OFF CACHE BOOL "Static Qt" FORCE)
set(QT_BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(QT_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
foreach(feature openssl opengl dbus sql testlib printsupport zstd brotli
    system_zlib system_pcre2 system_png system_jpeg system_freetype system_harfbuzz)
  set(FEATURE_${feature} OFF CACHE BOOL "Standalone Qt dependency" FORCE)
endforeach()
if(CMAKE_HOST_WIN32)
  set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded" CACHE STRING "Windows runtime" FORCE)
  set(FEATURE_static_runtime ON CACHE BOOL "Static Windows runtime" FORCE)
  set(FEATURE_schannel ON CACHE BOOL "Windows TLS" FORCE)
elseif(CMAKE_HOST_APPLE)
  set(CMAKE_OSX_DEPLOYMENT_TARGET 14.0 CACHE STRING "Minimum macOS version" FORCE)
  set(FEATURE_securetransport ON CACHE BOOL "macOS TLS" FORCE)
  execute_process(COMMAND xcode-select -p OUTPUT_VARIABLE apple_tools OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(apple_tools MATCHES "/CommandLineTools$")
    set(QT_NO_XCODE_MIN_VERSION_CHECK ON CACHE BOOL "Use the Command Line Tools SDK" FORCE)
  endif()
endif()
