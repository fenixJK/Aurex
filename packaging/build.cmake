cmake_minimum_required(VERSION 3.24)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT CMAKE_HOST_APPLE AND NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Build Aurex on macOS or Windows.")
endif()
if(NOT DEFINED JOBS)
  set(JOBS 3)
endif()
if(NOT JOBS MATCHES "^[1-9][0-9]*$")
  message(FATAL_ERROR "JOBS must be a positive integer.")
endif()
if(NOT DEFINED BUILD_DIR)
  set(BUILD_DIR "${ROOT}/build-native")
endif()
get_filename_component(BUILD_DIR "${BUILD_DIR}" ABSOLUTE BASE_DIR "${ROOT}")
set(DEPS "${BUILD_DIR}/deps")
file(MAKE_DIRECTORY "${DEPS}")
file(LOCK "${BUILD_DIR}/build.lock" GUARD PROCESS TIMEOUT 0)
find_program(NINJA ninja REQUIRED)
if(CMAKE_HOST_APPLE)
  find_program(XCRUN xcrun REQUIRED)
  execute_process(COMMAND "${XCRUN}" --find clang++ COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND uname -m OUTPUT_VARIABLE ARCH OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT ARCH MATCHES "^(arm64|x86_64)$")
    message(FATAL_ERROR "Unsupported Mac architecture: ${ARCH}")
  endif()
  set(PLATFORM_OPTIONS -DCMAKE_OSX_DEPLOYMENT_TARGET=14.0 "-DCMAKE_OSX_ARCHITECTURES=${ARCH}")
else()
  find_program(COMPILER cl REQUIRED)
  find_program(DUMPBIN dumpbin REQUIRED)
  find_program(GIT git REQUIRED)
  set(ARCH x64)
  set(PLATFORM_OPTIONS -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded)
endif()

function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${ROOT}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()

function(source_archive name url checksum result)
  set(archive "${DEPS}/${name}")
  if(NOT EXISTS "${archive}")
    message(STATUS "Downloading ${name}")
    file(DOWNLOAD "${url}" "${archive}.download" EXPECTED_HASH "SHA256=${checksum}" TLS_VERIFY ON)
    file(RENAME "${archive}.download" "${archive}")
  endif()
  file(SHA256 "${archive}" actual)
  if(NOT actual STREQUAL checksum)
    message(FATAL_ERROR "Checksum mismatch. Delete ${archive} and try again.")
  endif()
  string(REGEX REPLACE "\\.tar\\.(xz|gz)$" "" folder "${name}")
  set(source "${DEPS}/${folder}")
  if(NOT EXISTS "${source}/.aurex-extracted")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${DEPS}")
    file(WRITE "${source}/.aurex-extracted" "${checksum}")
  endif()
  set(${result} "${source}" PARENT_SCOPE)
endfunction()

function(build_library source directory destination)
  run("${CMAKE_COMMAND}" -S "${source}" -B "${directory}" -G Ninja
    "-DCMAKE_MAKE_PROGRAM=${NINJA}" -DCMAKE_BUILD_TYPE=Release
    "-DCMAKE_INSTALL_PREFIX=${destination}" ${PLATFORM_OPTIONS} ${ARGN})
  run("${CMAKE_COMMAND}" --build "${directory}" --parallel "${JOBS}")
  run("${CMAKE_COMMAND}" --install "${directory}")
endfunction()

set(QT_VERSION 6.8.3)
set(QT "${DEPS}/qt-install")
file(SHA256 "${ROOT}/cmake/StaticQt.cmake" qt_config)
set(qt_signature "${QT_VERSION}-${CMAKE_HOST_SYSTEM_NAME}-${ARCH}-${qt_config}")
set(previous "")
if(EXISTS "${QT}/.aurex-static")
  file(READ "${QT}/.aurex-static" previous)
endif()
if(NOT previous STREQUAL qt_signature)
  file(REMOVE "${QT}/.aurex-static")
  foreach(module qtbase qtwebsockets)
    set(options -C "${ROOT}/cmake/StaticQt.cmake")
    if(module STREQUAL "qtbase")
      set(hash 56001b905601bb9023d399f3ba780d7fa940f3e4861e496a7c490331f49e0b80)
    else()
      set(hash fc6310c1b12d6e22a31062727aa6574ed69239d036c8a4247b3b089902709b11)
      list(APPEND options "-DCMAKE_PREFIX_PATH=${QT}")
    endif()
    set(name "${module}-everywhere-src-${QT_VERSION}.tar.xz")
    source_archive("${name}" "https://download.qt.io/archive/qt/6.8/${QT_VERSION}/submodules/${name}" "${hash}" source)
    build_library("${source}" "${DEPS}/${module}-build" "${QT}"
      -DBUILD_SHARED_LIBS=OFF -DQT_BUILD_TESTS=OFF -DQT_BUILD_EXAMPLES=OFF ${options})
    foreach(folder LICENSES src/3rdparty)
      file(GLOB_RECURSE notices LIST_DIRECTORIES FALSE RELATIVE "${source}" "${source}/${folder}/*")
      foreach(notice IN LISTS notices)
        get_filename_component(label "${notice}" NAME)
        string(TOLOWER "${label}" label)
        if(folder STREQUAL "LICENSES" OR label MATCHES "^(license|copying|copyright|notice)" OR label STREQUAL "qt_attribution.json")
          configure_file("${source}/${notice}" "${QT}/share/aurex-notices/${module}/${notice}" COPYONLY)
        endif()
      endforeach()
    endforeach()
  endforeach()
  file(WRITE "${QT}/.aurex-static" "${qt_signature}")
endif()

if(CMAKE_HOST_APPLE)
  set(CRYPTO "${DEPS}/openssl-install")
  if(NOT EXISTS "${CRYPTO}/lib/libcrypto.a")
    run(bash "${ROOT}/packaging/host-crypto-macos.sh" "${DEPS}" "${JOBS}")
  endif()
else()
  set(vcpkg "${DEPS}/vcpkg")
  set(CRYPTO "${vcpkg}/installed/x64-windows-static")
  if(NOT EXISTS "${CRYPTO}/lib/libcrypto.lib")
    if(NOT EXISTS "${vcpkg}/.git")
      run("${GIT}" clone --depth 1 https://github.com/microsoft/vcpkg.git "${vcpkg}")
    endif()
    if(NOT EXISTS "${vcpkg}/vcpkg.exe")
      run(cmd /c "${vcpkg}/bootstrap-vcpkg.bat" -disableMetrics)
    endif()
    run("${vcpkg}/vcpkg.exe" install openssl:x64-windows-static)
  endif()
endif()

set(VISION "${DEPS}/opencv-install")
file(SHA256 "${ROOT}/cmake/ReleaseVision.cmake" vision_config)
set(vision_signature "4.13.0-${CMAKE_HOST_SYSTEM_NAME}-${ARCH}-${vision_config}")
set(previous "")
if(EXISTS "${VISION}/.aurex-static")
  file(READ "${VISION}/.aurex-static" previous)
endif()
if(NOT previous STREQUAL vision_signature)
  file(REMOVE "${VISION}/.aurex-static")
  source_archive("opencv-4.13.0.tar.gz" "https://github.com/opencv/opencv/archive/refs/tags/4.13.0.tar.gz"
    1d40ca017ea51c533cf9fd5cbde5b5fe7ae248291ddf2af99d4c17cf8e13017d source)
  build_library("${source}" "${DEPS}/opencv-build" "${VISION}" -C "${ROOT}/cmake/ReleaseVision.cmake")
  file(WRITE "${VISION}/.aurex-static" "${vision_signature}")
endif()

set(APP_BUILD "${BUILD_DIR}/app")
run("${CMAKE_COMMAND}" -S "${ROOT}" -B "${APP_BUILD}" -G Ninja
  "-DCMAKE_MAKE_PROGRAM=${NINJA}" -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF -DOpenCV_STATIC=ON
  "-DCMAKE_PREFIX_PATH=${QT}" "-DOpenCV_ROOT=${VISION}" "-DOPENSSL_ROOT_DIR=${CRYPTO}"
  "-DAUREX_VERSION_SUFFIX=${AUREX_VERSION_SUFFIX}" ${PLATFORM_OPTIONS})
run("${CMAKE_COMMAND}" --build "${APP_BUILD}" --parallel "${JOBS}")
include("${ROOT}/packaging/notices.cmake")
if(CMAKE_HOST_APPLE)
  include("${ROOT}/packaging/macos.cmake")
else()
  set(ENV{RUNNER_TEMP} "${DEPS}")
  run(powershell.exe -NoProfile -ExecutionPolicy Bypass -File "${ROOT}/packaging/windows.ps1"
    -BuildDir "${APP_BUILD}" -NoticesFile "${NOTICES}")
endif()
message(STATUS "Done. Your Aurex app and ZIP are in ${ROOT}/dist")
