file(STRINGS "${APP_BUILD}/release-version.txt" version)
if(ARCH STREQUAL "arm64")
  set(package macOS-arm64)
else()
  set(package macOS-x64)
endif()
set(stage "${ROOT}/dist/Aurex-${version}-${package}")
set(app "${stage}/Aurex.app")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}")
run(ditto "${APP_BUILD}/Aurex.app" "${app}")
file(REMOVE_RECURSE "${app}/Contents/Resources/licenses")
file(COPY "${ROOT}/LICENSE" "${NOTICES}" DESTINATION "${app}/Contents/Resources")
set(binary "${app}/Contents/MacOS/Aurex")
execute_process(COMMAND lipo -archs "${binary}" OUTPUT_VARIABLE architectures OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT architectures STREQUAL ARCH)
  message(FATAL_ERROR "Unexpected Mac architecture: ${architectures}")
endif()
run(strip -S -x "${binary}")
execute_process(COMMAND otool -L "${binary}" OUTPUT_VARIABLE libraries COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "\n\t[^\n]+" libraries "${libraries}")
foreach(library IN LISTS libraries)
  string(STRIP "${library}" library)
  if(NOT library MATCHES "^(/System/Library/|/usr/lib/)")
    message(FATAL_ERROR "Executable still requires an external library: ${library}")
  endif()
endforeach()
if(NOT libraries)
  message(FATAL_ERROR "Executable dependency list is empty")
endif()
execute_process(COMMAND otool -l "${binary}" OUTPUT_VARIABLE commands COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "cmd LC_RPATH\n[^\n]*\n[^\n]*" rpaths "${commands}")
foreach(command IN LISTS rpaths)
  string(REGEX REPLACE ".*\n[ \t]*path (.*) \\(offset.*" "\\1" path "${command}")
  if(IS_ABSOLUTE "${path}" AND NOT path MATCHES "^(/System/|/usr/lib/)")
    run(install_name_tool -delete_rpath "${path}" "${binary}")
  endif()
endforeach()
run(codesign --force --sign - "${app}")
run(codesign --verify --deep --strict "${app}")

set(smoke "${BUILD_DIR}/package-check")
file(REMOVE_RECURSE "${smoke}")
file(MAKE_DIRECTORY "${smoke}")
run(ditto "${app}" "${smoke}/Aurex.app")
execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE environment)
string(REPLACE "\n" ";" environment "${environment}")
foreach(variable IN LISTS environment)
  if(variable MATCHES "^((DYLD_|QT_|QML)[^=]*)=")
    unset(ENV{${CMAKE_MATCH_1}})
  endif()
endforeach()
set(ENV{QT_QPA_PLATFORM} cocoa)
execute_process(COMMAND "${smoke}/Aurex.app/Contents/MacOS/Aurex" --screenshot "${smoke}/startup.png"
  WORKING_DIRECTORY "${smoke}" TIMEOUT 30 RESULT_VARIABLE result)
if(NOT result STREQUAL "0" OR NOT EXISTS "${smoke}/startup.png")
  message(FATAL_ERROR "Packaged application startup failed: ${result}")
endif()
file(REMOVE_RECURSE "${smoke}")
run(ditto -c -k --sequesterRsrc --keepParent "${app}" "${stage}.zip")
