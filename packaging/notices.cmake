set(NOTICES "${BUILD_DIR}/THIRD_PARTY_NOTICES.txt")
file(SHA256 "${ROOT}/LICENSE" main_license)
set(notice_hashes "")
foreach(component Aurex Qt OpenCV)
  if(component STREQUAL "Aurex")
    set(directory "${ROOT}/licenses")
  elseif(component STREQUAL "Qt")
    set(directory "${QT}/share/aurex-notices")
  elseif(CMAKE_HOST_APPLE)
    set(directory "${VISION}/share/licenses/opencv4")
  else()
    set(directory "${VISION}/etc/licenses")
  endif()
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${directory}" "${directory}/*")
  if(NOT files)
    message(FATAL_ERROR "Missing ${component} license notices: ${directory}")
  endif()
  foreach(file IN LISTS files)
    if(component STREQUAL "Qt")
      if(file MATCHES "^qtbase/src/3rdparty/(android|gradle|wasm|xcb|sqlite)/")
        continue()
      endif()
      if(CMAKE_HOST_APPLE AND file MATCHES "^qtbase/src/3rdparty/(iaccessible2|wintab|D3D12MemoryAllocator)/")
        continue()
      endif()
    endif()
    file(SHA256 "${directory}/${file}" hash)
    if(hash STREQUAL main_license)
      continue()
    endif()
    if(NOT hash IN_LIST notice_hashes)
      list(APPEND notice_hashes "${hash}")
      file(READ "${directory}/${file}" notice_${hash})
    endif()
    string(APPEND sources_${hash} "${component}/${file}\n")
  endforeach()
endforeach()
file(WRITE "${NOTICES}" "Aurex third-party notices\n\nThe main GPL-3.0 license is in LICENSE. Original notice filenames below identify each section. Identical texts are included once, with all their sources listed.\n")
foreach(hash IN LISTS notice_hashes)
  file(APPEND "${NOTICES}" "\n============================================================\n${sources_${hash}}============================================================\n\n${notice_${hash}}\n")
endforeach()
